00, "link": null, "locked": false, "text": "A bank counter line: new people join at the rear (enqueue),\nthe person at the front is served and leaves (dequeue).\nThe hall has limited space — full = overflow, empty = underflow.", "originalText": "A bank counter line: new people join at the rear (enqueue),\nthe person at the front is served and leaves (dequeue).\nThe hall has limited space — full = overflow, empty = underflow.", "fontSize": 17, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "45c08926f1e3434cb9647305ec81e0ab", "lineHeight": 1.25}, {"id": "cd5f935799c64d409975ed4901163f18", "type": "ellipse", "x": 155.0, "y": 497, "width": 150, "height": 54, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 1605936202, "version": 1, "versionNonce": 1369793840, "isDeleted": false, "boundElements": [{"id": "246eea9dcb714c9ebe44b9093735aebe", "type": "text"}], "updated": 1732492800000, "link": null, "locked": false}, {"id": "246eea9dcb714c9ebe44b9093735aebe", "type": "text", "x": 155.0, "y": 512.125, "width": 150, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 917719342, "version": 1, "versionNonce": 2066949599, "isDeleted": false, "boundElements": null, "updated": 1732492800000, "link": null, "locked": false, "text": "Start", "originalText": "Start", "fontSize": 19, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "cd5f935799c64d409975ed4901163f18", "lineHeight": 1.25}, {"id": "0018b577bc864365bc3c55adeb6a2871", "type": "rectangle", "x": 96.19999999999999, "y": 595, "width": 267.6, "height": 69.5, "angle": 0, "strokeColor": "#1e1e1e"