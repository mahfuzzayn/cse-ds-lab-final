, "groupIds": [], "frameId": null, "roundness": null, "seed": 401008916, "version": 1, "versionNonce": 317120130, "isDeleted": false, "boundElements": null, "updated": 1732492800000, "link": null, "locked": false, "text": "1-based input, 0-based storage:\nvertex u → row u-1", "originalText": "1-based input, 0-based storage:\nvertex u → row u-1", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25}, {"id": "8cc829f809d04445875f634e31a63ba5", "type": "text", "x": 760, "y": 360, "width": 386.0, "height": 56.25, "angle": 0, "strokeColor": "#707070", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 340899285, "version": 1, "versionNonce": 1167457305, "isDeleted": false, "boundElements": null, "updated": 1732492800000, "link": null, "locked": false, "text": "The matrix is symmetric: edge (2,3) sets\nboth [1][2] and [2][1] — mirror along the\ndiagonal, because the graph is undirected.", "originalText": "The matrix is symmetric: edge (2,3) sets\nboth [1][2] and [2][1] — mirror along the\ndiagonal, because the graph is undirected.", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25}, {"id": "fe99ae63af9d416d9aa0d105a8ca97d0", "type": "text", "x": 60, "y": 1074.5, "width": 923.6, "height": 17.5, "angle": 0, "strokeColor": "#707070", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1278307809, "version": 1, "versionNonce": 1342338798, "isDeleted": false, "boundElements": null, "updated": 1732492800000, "link": null, "locked": false, "text": "Full write-up: Explanations/11_undirected_graph_matrix.md   •   Code: Problems/11_undirected_graph_matrix.cpp", "originalText": "