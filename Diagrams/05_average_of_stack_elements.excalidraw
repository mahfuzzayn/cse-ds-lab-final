bcf404cfb85b55f59b186e378", "type": "text", "x": 669.0, "y": 359.125, "width": 400, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1049719504, "version": 1, "versionNonce": 1632615816, "isDeleted": false, "boundElements": null, "updated": 1732492800000, "link": null, "locked": false, "text": "Sum = 31,  Average = 10.3333", "originalText": "Sum = 31,  Average = 10.3333", "fontSize": 19, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "9ed1c42751504a55ae308fe09e04176b", "lineHeight": 1.25}, {"id": "2035ce61c3834fb6a5330d3405bc3e35", "type": "text", "x": 810, "y": 414, "width": 458.0, "height": 37.5, "angle": 0, "strokeColor": "#707070", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 204098697, "version": 1, "versionNonce": 549342887, "isDeleted": false, "boundElements": null, "updated": 1732492800000, "link": null, "locked": false, "text": "The cast to double matters: 31 / 3 as int division\nwould wrongly give 10 (the .3333 would be lost).", "originalText": "The cast to double matters: 31 / 3 as int division\nwould wrongly give 10 (the .3333 would be lost).", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25}, {"id": "6e2c1eaa77a44643ba1cc8de1659ea17", "type": "text", "x": 60, "y": 1281.0, "width": 957.1999999999999, "height": 17.5, "angle": 0, "strokeColor": "#707070", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 385859353, "version": 1, "versionNonce": 1285790652, "isDeleted": false, "boun